{
  "manifest_version": 3,
  "name": "Premium Google Info Search",
  "description": "Bulk Google business and local place search by keyword, category, location, and zip code with Serper.dev API support and CSV export.",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Google Info Search",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "cookies",
    "downloads",
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.google.com/*",
    "https://google.serper.dev/*",
    "https://node.justfinejob.store/*",
    "https://integrate.api.nvidia.com/*",
    "https://html.duckduckgo.com/*",
    "https://duckduckgo.com/*",
    "https://*.duckduckgo.com/*",
    "https://search.yahoo.com/*",
    "https://*.yahoo.com/*"
  ]
}
